{
  "name": "valtra",
  "version": "0.1.6",
  "packageManager": "pnpm@10.25.0",
  "description": "Runtime JavaScript codegen",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/tilyupo/valtra#readme",
  "bugs": {
    "url": "https://github.com/tilyupo/valtra/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tilyupo/valtra.git"
  },
  "author": "Dmitry Tilyupo <tilyupo@gmail.com>",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "codegen",
    "wasm"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "release": "bumpp -r --commit 'chore: release v%s' --tag 'v%s' --push",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix",
    "format": "prettier --write \"{src,tests}/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"{src,tests}/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "bumpp": "^10.1.0",
    "editorconfig": "^3.0.2",
    "eslint": "^9.18.0",
    "prettier": "^3.6.2",
    "tsdown": "^0.11.9",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.1.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
